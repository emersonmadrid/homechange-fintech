@{
    ViewBag.Title = "Gestor Tipo de Cambio";
}

<div class="row" style="margin-bottom: 20px;">
    <div class="col-md-12">
        <h2 style="color: var(--accent); font-weight: 700;">Actualizar Tipo de Cambio</h2>
        <p style="color: var(--text-secondary);">Configura los precios del día para compra y venta de dólares.</p>
    </div>
</div>

<div class="row">
    <div class="col-md-6 col-md-offset-3">
        <div class="glass-card">
            @using (Html.BeginForm("ActualizarTipoCambio", "Admin", FormMethod.Post, new { id = "frmTipoCambio" }))
            {
                @Html.AntiForgeryToken()
                
                <div class="form-group" style="margin-bottom: 20px;">
                    <label style="color: var(--text-secondary); display: block;">Precio Compra Actual: <strong style="color: var(--text-primary); font-size: 18px;">@(ViewBag.TipoCambio != null ? ViewBag.TipoCambio.monto_compra : "0")</strong></label>
                    <input type="number" step="0.001" name="precioCompra" class="form-control" placeholder="Nuevo Precio Compra" required style="width: 100%; max-width: 100%;" />
                </div>
                
                <div class="form-group" style="margin-bottom: 30px;">
                    <label style="color: var(--text-secondary); display: block;">Precio Venta Actual: <strong style="color: var(--text-primary); font-size: 18px;">@(ViewBag.TipoCambio != null ? ViewBag.TipoCambio.monto_venta : "0")</strong></label>
                    <input type="number" step="0.001" name="precioVenta" class="form-control" placeholder="Nuevo Precio Venta" required style="width: 100%; max-width: 100%;" />
                </div>
                
                <button type="submit" class="btn btn-accent" style="width: 100%;">
                    <i class="glyphicon glyphicon-floppy-disk"></i> Guardar y Publicar
                </button>
            }
        </div>
    </div>
</div>

<script>
    document.getElementById("frmTipoCambio").addEventListener("submit", function (e) {
        e.preventDefault();
        var formData = new FormData(this);
        fetch(this.action, {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            if(data.success) {
                alert("Tipo de cambio actualizado exitosamente");
                location.reload();
            } else {
                alert("Error al actualizar");
            }
        });
    });
</script>
